# Only needed for --mode llm. The default run is offline and needs nothing.

# Any OpenAI-compatible endpoint: OpenAI, OpenRouter, Azure, Ollama (http://localhost:11434/v1)...
LLM_API_KEY=
LLM_BASE_URL=

# One model for everything, or override per role.
# Tip: use a DIFFERENT (ideally stronger) model for the judge than for the agent.
LLM_MODEL=gpt-4o-mini
AGENT_MODEL=
TESTER_MODEL=
JUDGE_MODEL=

# Langfuse (cloud or self-hosted). Tracing turns on automatically when both keys are set.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
